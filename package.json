    "@fontsource-variable/inter": "5.1.0",
    "canvas-confetti": "1.9.3",
    "framer-motion": "11.5.6",
    "lucide-react": "0.446.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "workbox-window": "7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/canvas-confetti": "1.6.4",
    "@types/node": "^22.12.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
